  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "globals": "16.4.0",
    "pg": "8.16.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
