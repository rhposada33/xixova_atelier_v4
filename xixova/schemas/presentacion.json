{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xixova.local/schemas/v1/presentacion.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "exposicion": {
      "type": "number"
    },
    "entorno": {
      "type": "object",
      "properties": {
        "color": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "intensidad": {
          "type": "number",
          "minimum": 0
        },
        "archivo": {
          "type": "string",
          "minLength": 1
        },
        "rotacion_grados": {
          "type": "number"
        }
      },
      "required": [
        "color",
        "intensidad"
      ],
      "additionalProperties": false
    },
    "sol": {
      "type": "object",
      "properties": {
        "azimut_grados": {"type": "number"},
        "elevacion_grados": {"type": "number", "minimum": -5, "maximum": 90},
        "energia": {"type": "number", "minimum": 0},
        "angulo_grados": {"type": "number", "minimum": 0.1, "maximum": 15},
        "temperatura_k": {"type": "number", "minimum": 1800, "maximum": 12000}
      },
      "required": ["azimut_grados", "elevacion_grados", "energia", "temperatura_k"],
      "additionalProperties": false
    },
    "color": {
      "type": "object",
      "properties": {
        "look": {"enum": ["Medium High Contrast", "Medium Low Contrast", "None"]},
        "balance_blancos_k": {"type": "number", "minimum": 2000, "maximum": 12000},
        "tinte": {"type": "number", "minimum": -1, "maximum": 1}
      },
      "additionalProperties": false
    },
    "postproduccion": {
      "type": "object",
      "properties": {
        "contraste": {"type": "number", "minimum": 0.8, "maximum": 1.3},
        "saturacion": {"type": "number", "minimum": 0.7, "maximum": 1.3},
        "vineta": {"type": "number", "minimum": 0, "maximum": 0.4},
        "grano": {"type": "number", "minimum": 0, "maximum": 8},
        "bloom": {"type": "number", "minimum": 0, "maximum": 0.2}
      },
      "additionalProperties": false
    },
    "luces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "posicion": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "objetivo": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "potencia": {
            "type": "number",
            "minimum": 0
          },
          "tamano": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "color": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "tipo": {"enum": ["AREA", "POINT", "SPOT"]},
          "temperatura_k": {"type": "number", "minimum": 1800, "maximum": 12000},
          "forma": {"enum": ["DISK", "RECTANGLE", "SQUARE"]},
          "tamano_y": {"type": "number", "exclusiveMinimum": 0}
        },
        "required": [
          "id",
          "posicion",
          "objetivo",
          "potencia",
          "tamano",
          "color"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "tomas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "lente": {
            "type": "number",
            "minimum": 18,
            "maximum": 70
          },
          "fotogramas": {
            "type": "integer",
            "minimum": 2
          },
          "interpolacion": {
            "enum": ["lineal", "suave"]
          },
          "apertura_f": {"type": "number", "minimum": 1.2, "maximum": 22},
          "foco": {"type": "string", "minLength": 1},
          "sensor_mm": {"type": "number", "minimum": 20, "maximum": 70},
          "exposicion": {"type": "number", "minimum": -5, "maximum": 5},
          "puntos": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "posicion": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "objetivo": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                }
              },
              "required": [
                "posicion",
                "objetivo"
              ],
              "additionalProperties": false
            },
            "minItems": 2
          }
        },
        "required": [
          "id",
          "lente",
          "fotogramas",
          "puntos"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema",
    "exposicion",
    "entorno",
    "luces",
    "tomas"
  ],
  "additionalProperties": false
}
