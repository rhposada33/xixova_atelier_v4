{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xixova.local/schemas/v1/presentacion.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "exposicion": {
      "type": "number"
    },
    "entorno": {
      "type": "object",
      "properties": {
        "color": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "intensidad": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "color",
        "intensidad"
      ],
      "additionalProperties": false
    },
    "luces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "posicion": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "objetivo": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "potencia": {
            "type": "number",
            "minimum": 0
          },
          "tamano": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "color": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "required": [
          "id",
          "posicion",
          "objetivo",
          "potencia",
          "tamano",
          "color"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "tomas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "lente": {
            "type": "number",
            "minimum": 18,
            "maximum": 70
          },
          "fotogramas": {
            "type": "integer",
            "minimum": 2
          },
          "interpolacion": {
            "enum": ["lineal", "suave"]
          },
          "puntos": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "posicion": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "objetivo": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                }
              },
              "required": [
                "posicion",
                "objetivo"
              ],
              "additionalProperties": false
            },
            "minItems": 2
          }
        },
        "required": [
          "id",
          "lente",
          "fotogramas",
          "puntos"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema",
    "exposicion",
    "entorno",
    "luces",
    "tomas"
  ],
  "additionalProperties": false
}
