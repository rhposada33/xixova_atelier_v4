{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xixova.local/schemas/v1/proyecto.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "arquitectura": {
      "type": "string",
      "minLength": 1
    },
    "variantes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]+$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "presentacion": {
      "type": "string",
      "minLength": 1
    },
    "guion_camara": {
      "type": "string",
      "minLength": 1
    },
    "realismo": {
      "type": "object",
      "properties": {
        "perfil": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"},
        "calidad": {"enum": ["equilibrada", "fotografica"]},
        "semilla": {"type": "integer"},
        "hora_solar": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"},
        "densidad_decoracion": {"enum": ["baja", "media", "alta"]}
      },
      "required": ["perfil", "calidad", "semilla", "hora_solar", "densidad_decoracion"],
      "additionalProperties": false
    },
    "produccion": {
      "type": "object",
      "properties": {
        "catalogo": {
          "type": "string",
          "minLength": 1
        },
        "bibliotecas": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "blender": {
          "type": "string",
          "minLength": 1
        },
        "salidas": {
          "type": "string",
          "minLength": 1
        },
        "fps": {
          "type": "integer",
          "minimum": 1
        },
        "gpu_vram_gb": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ram_gb": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "licencias_permitidas": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "perfiles": {
          "type": "object",
          "properties": {
            "previa": {
              "type": "object",
              "properties": {
                "resolucion": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 2,
                    "multipleOf": 2
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "muestras": {
                  "type": "integer",
                  "minimum": 1
                },
                "motor": {
                  "enum": [
                    "CYCLES",
                    "BLENDER_WORKBENCH"
                  ]
                },
                "denoise": {
                  "type": "boolean"
                },
                "umbral_adaptativo": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "crf": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 51
                },
                "preset": {
                  "enum": [
                    "ultrafast",
                    "superfast",
                    "veryfast",
                    "faster",
                    "fast",
                    "medium",
                    "slow",
                    "slower",
                    "veryslow"
                  ]
                },
                "max_rebotes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 32
                },
                "rebotes_difusos": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16
                },
                "rebotes_brillantes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16
                },
                "rebotes_transmision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16
                },
                "clamp_indirecto": {
                  "type": "number",
                  "minimum": 0
                },
                "profundidad_color": {
                  "enum": [
                    "8",
                    "16"
                  ]
                }
              },
