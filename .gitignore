*.png
*.jpg
*.jpeg
*.exr
*.hdr
*.tif
*.tiff
*.webp
*.mp4
*.mov
*.mkv
*.avi
*.wav
*.mp3

# Modelos y paquetes binarios externos
*.glb
*.gltf
*.bin
*.zip
*.tar
*.tar.gz
*.7z

# Logs y temporales
*.log
*.jsonl
*.tmp
*.lock
*~
.DS_Store
Thumbs.db

# Artefactos locales de la variante aislada del edificio Visual V2
